<% content_for :title, @page.title %>
<%= render layout: "wiki_pages/workspace", locals: { current: @page } do %>
  <article class="surface-card p-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <h2 class="text-2xl font-bold tracking-tight"><%= @page.title %></h2>
      <div class="flex gap-2">
        <%= link_to "Edit", edit_wiki_page_path(@page), class: "btn btn-outline btn-sm" %>
        <%= button_to "Delete", wiki_page_path(@page), method: :delete, class: "btn btn-ghost btn-sm text-error",
              form: { data: { turbo_confirm: "Delete #{@page.title}?" } } %>
      </div>
    </div>
    <div class="markdown prose prose-sm mt-4 max-w-none text-base-content/80">
      <%= markdown(@page.content) %>
    </div>
    <% if @linked_items.any? %>
      <section class="mt-8 border-t border-base-300 pt-6">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-base-content/50">Linked inventory</h3>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <% @linked_items.each do |item| %>
            <%= link_to item_path(item), class: "flex items-center gap-3 rounded-xl border border-base-300 bg-base-200/50 p-3 text-left transition hover:border-primary/40 hover:bg-primary/5" do %>
              <span class="flex size-11 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-base-300 text-base-content/30">
                <% if item.cover_photo %>
                  <%= image_tag item.cover_photo, alt: "", class: "size-full object-cover" %>
                <% else %>
                  <%= icon :package, size: 18 %>
                <% end %>
              </span>
              <span class="min-w-0">
                <strong class="block truncate text-sm"><%= item.name %></strong>
                <span class="block truncate text-xs text-base-content/60"><%= item.location.presence || "No location" %></span>
              </span>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>
  </article>
<% end %>
