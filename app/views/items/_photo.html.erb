<div class="group/photo relative aspect-square overflow-hidden rounded-xl bg-base-200" data-photo>
  <img src="<%= photo %>" alt="" class="size-full object-cover transition group-data-uploading/photo:opacity-50">
  <input type="hidden" name="item[photos][]" value="<%= photo %>">
  <span class="loading loading-spinner absolute inset-0 m-auto hidden text-primary group-data-uploading/photo:block"></span>
  <span class="badge badge-primary badge-sm absolute bottom-1.5 left-1.5 hidden gap-1 group-data-cover/photo:inline-flex">
    <%= icon :star, size: 10 %> Cover
  </span>
  <button type="button" class="btn btn-circle btn-xs absolute bottom-1.5 left-1.5 border-0 bg-base-100/90 shadow group-data-cover/photo:hidden group-data-uploading/photo:hidden"
          data-action="photos#makeCover" aria-label="Use as cover photo" title="Use as cover">
    <%= icon :star, size: 14 %>
  </button>
  <button type="button" class="btn btn-circle btn-xs absolute right-1.5 top-1.5 border-0 bg-base-100/90 shadow group-data-uploading/photo:hidden"
          data-action="photos#remove" aria-label="Remove photo">
    <%= icon :close, size: 14 %>
  </button>
</div>
