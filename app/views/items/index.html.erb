<% content_for :title, "Inventory" %>
<% if params[:item] == "new" %>
  <% content_for :modal_src, new_item_path %>
<% elsif @open_item %>
  <% content_for :modal_src, edit_item_path(@open_item) %>
<% end %>

<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div>
    <h1 class="page-title">Inventory</h1>
    <p class="page-subtitle"><%= pluralize(@all_count, "tool and supply", plural: "tools and supplies") %></p>
  </div>
  <%= link_to new_item_path(return_to: request.fullpath), class: "btn btn-primary gap-2 shadow-md shadow-primary/20", data: { turbo_frame: "modal" } do %>
    <%= icon :plus, size: 18 %>
    Add item
  <% end %>
</div>

<%= form_with url: root_path, method: :get, class: "mt-6", role: "search",
      data: { controller: "search", turbo_frame: "items", turbo_action: "advance" } do |form| %>
  <label class="input w-full bg-base-100 shadow-sm">
    <%= icon :search, size: 18, class: "shrink-0 text-base-content/40" %>
    <%= form.search_field :q, value: @query, class: "grow", autocomplete: "off",
          placeholder: "Search name, manufacturer, tags, location...", aria: { label: "Search inventory" },
          data: { action: "input->search#submit" } %>
  </label>
<% end %>

<%= turbo_frame_tag "items", target: "_top" do %>
  <% if @query.present? %>
    <p class="mt-4 text-sm text-base-content/60"><%= pluralize(@items.size, "match") %> for “<%= @query %>”</p>
  <% end %>
  <% if @items.empty? %>
    <div class="empty-state mt-6">
      <%= icon :package, size: 40, class: "text-base-content/25" %>
      <p class="font-medium text-base-content/70">No matching items yet</p>
      <p class="text-sm">Add your first tool or adjust your search.</p>
    </div>
  <% else %>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      <%= render partial: "items/item", collection: @items %>
    </div>
  <% end %>
<% end %>
