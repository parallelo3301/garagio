<%# Full-page item editor shared by new and edit. %>
<% cancel_url = item.persisted? ? item_path(item) : root_path(kind: item.kind) %>
<% content_for :hide_dock, true %>

<div class="mx-auto max-w-3xl">
  <div class="flex items-center justify-between gap-3">
    <%= link_to cancel_url, class: "btn btn-ghost btn-sm -ml-2 gap-1.5 text-base-content/70",
          data: (item.persisted? ? { turbo_action: "replace" } : { controller: "history-back", action: "history-back#go" }) do %>
      <%= icon :arrow_left, size: 18 %> Cancel
    <% end %>
  </div>
  <h1 class="page-title mt-2"><%= item.persisted? ? "Edit #{item.tool? ? "tool" : "material"}" : "New item" %></h1>

  <%= form_with model: item, id: "item_form", class: "mt-5 space-y-4", data: { controller: "item-form borrowed", turbo_action: "replace" } do |form| %>
    <%= render "shared/errors", record: item %>
    <%= render "items/ai_fill" if @ai_configured %>

    <section class="form-card space-y-4">
      <div role="radiogroup" aria-label="Item type" class="grid grid-cols-2 gap-1 rounded-field bg-base-200 p-1">
        <% Item::KINDS.each do |kind| %>
          <label class="kind-option">
            <%= form.radio_button :kind, kind, class: "peer sr-only", data: { item_form_target: "kind", action: "item-form#toggle" } %>
            <span class="flex min-h-10 items-center justify-center gap-2 rounded-[calc(var(--radius-field)-2px)] text-sm font-medium text-base-content/60 transition peer-checked:bg-base-100 peer-checked:text-base-content peer-checked:shadow-sm peer-focus-visible:ring-2 peer-focus-visible:ring-primary">
              <%= icon(kind == "tool" ? :wrench : :boxes, size: 16) %>
              <%= kind == "tool" ? "Tool" : "Material" %>
            </span>
          </label>
        <% end %>
      </div>
      <p class="-mt-1 text-xs text-base-content/50">
        <span data-kind-label="tool">One item per tool. Got two of the same? Save this one, then use “Duplicate”.</span>
        <span data-kind-label="material" hidden>Consumables like screws, nails or glue, with a rough amount.</span>
      </p>

      <label class="block">
        <span class="field-label">Name</span>
        <%= form.text_field :name, class: "input w-full", required: true, placeholder: "e.g. Cordless drill DCD996", autocomplete: "off" %>
      </label>

      <div data-kind-only="material" hidden>
        <label class="block">
          <span class="field-label">Amount</span>
          <%= form.text_field :amount, value: item.amount.presence || (item.material? && item.quantity.positive? ? item.quantity : nil),
                class: "input w-full", placeholder: "e.g. 100+, half a box, 2 kg", autocomplete: "off", data: { item_form_target: "amount" } %>
        </label>
        <div class="mt-2 flex flex-wrap gap-1.5">
          <% Item::AMOUNT_PRESETS.each do |preset| %>
            <button type="button" class="btn btn-xs btn-soft rounded-full" data-action="item-form#preset" data-value="<%= preset %>"><%= preset %></button>
          <% end %>
        </div>
      </div>
    </section>

    <%= render "items/photos", form:, item: %>

    <section class="form-card">
      <label class="block">
        <span class="flex items-baseline justify-between">
          <span class="field-label">Description</span>
          <span class="text-xs text-base-content/40">Markdown supported</span>
        </span>
        <%= form.text_area :description, rows: 8, class: "textarea min-h-48 w-full resize-y leading-relaxed",
              placeholder: "Specs, accessories, notes...", data: { controller: "autogrow", action: "input->autogrow#resize" } %>
      </label>
    </section>

    <section class="form-card space-y-4">
      <div>
        <span class="field-label">Location</span>
        <%= render "items/chips", name: "item[location]", value: item.location, suggestions: @location_suggestions,
              multiple: false, noun: "location", placeholder: "Shelf, drawer, garage..." %>
      </div>
      <div>
        <span class="field-label">Tags</span>
        <%= render "items/chips", name: "item[tag_list]", value: item.tag_list, suggestions: @tag_suggestions,
              multiple: true, noun: "tag", placeholder: "Add tags..." %>
      </div>
      <label class="block">
        <span class="field-label">Manufacturer</span>
        <%= form.collection_select :manufacturer_id, @manufacturers, :id, :name, { include_blank: "None" }, class: "select w-full" %>
      </label>
    </section>

    <section class="form-card space-y-4">
      <label class="block">
        <span class="field-label">Status</span>
        <%= form.select :status, Item::STATUSES.map { |status| [ status.tr("_", " ").capitalize, status ] }, {},
              class: "select w-full", data: { borrowed_target: "status", action: "borrowed#toggle" } %>
      </label>
      <div class="grid grid-cols-2 gap-4" data-borrowed-target="fields">
        <label class="block">
          <span class="field-label">Borrowed to</span>
          <%= form.text_field :borrowed_to, class: "input w-full" %>
        </label>
        <label class="block">
          <span class="field-label">Borrowed date</span>
          <%= form.date_field :borrowed_at, class: "input w-full" %>
        </label>
      </div>
    </section>

    <section class="form-card space-y-5">
      <%= render "items/links", item: %>
      <%= render "items/wiki_links", item: %>
    </section>
  <% end %>

  <div class="sticky bottom-0 z-20 -mx-4 mt-6 flex gap-3 border-t border-base-300 bg-base-100/95 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur sm:bottom-4 sm:mx-0 sm:justify-end sm:rounded-2xl sm:border sm:p-3 sm:shadow-lg">
    <%= link_to "Cancel", cancel_url, class: "btn btn-ghost flex-1 sm:flex-none",
          data: (item.persisted? ? { turbo_action: "replace" } : { controller: "history-back", action: "history-back#go" }) %>
    <button type="submit" form="item_form" class="btn btn-primary flex-[2] sm:flex-none sm:px-10">Save</button>
  </div>

  <% if item.persisted? %>
    <section class="mt-8 flex items-center justify-between gap-3 rounded-2xl border border-error/20 bg-error/5 p-4">
      <div class="text-sm">
        <p class="font-medium">Delete this item</p>
        <p class="text-base-content/60">Photos stay on disk; the item and its links are removed.</p>
      </div>
      <%= button_to item_path(item), method: :delete, class: "btn btn-error btn-outline btn-sm gap-1.5",
            form: { data: { turbo_confirm: "Delete #{item.name}?", turbo_action: "replace" } } do %>
        <%= icon :trash, size: 16 %> Delete
      <% end %>
    </section>
  <% end %>
</div>

