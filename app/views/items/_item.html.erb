<%= link_to item_path(item), id: dom_id(item),
      class: "group flex items-center gap-3 p-3 text-left transition active:bg-base-200 sm:surface-card sm:flex-col sm:items-stretch sm:gap-0 sm:overflow-hidden sm:p-0 sm:hover:-translate-y-0.5 sm:hover:border-primary/30 sm:hover:shadow-lg" do %>
  <figure class="flex size-16 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-base-200 sm:h-40 sm:w-full sm:rounded-none sm:p-4">
    <% if item.cover_photo %>
      <%= image_tag item.cover_photo, alt: "", loading: "lazy", class: "size-full object-cover sm:size-auto sm:max-h-full sm:max-w-full sm:object-contain sm:transition sm:group-hover:scale-[1.02]" %>
    <% else %>
      <%= icon(item.tool? ? :wrench : :boxes, size: 24, class: "text-base-content/25") %>
    <% end %>
  </figure>
  <div class="min-w-0 flex-1 space-y-1 sm:space-y-2 sm:p-4">
    <div class="flex items-start justify-between gap-2">
      <h2 class="line-clamp-2 font-semibold leading-snug"><%= item.name %></h2>
      <% if item.amount_label %>
        <span class="badge badge-sm badge-soft badge-secondary whitespace-nowrap font-medium"><%= item.amount_label %></span>
      <% end %>
    </div>
    <p class="truncate text-sm text-base-content/60">
      <%= [ item.manufacturer&.name, item.location.presence, item.tag_list.presence ].compact.join(" · ").presence || "—" %>
    </p>
    <% unless item.status == "in_stock" %>
      <span class="<%= status_badge_class(item.status) %>">
        <%= item.borrowed? && item.borrowed_to ? "borrowed · #{item.borrowed_to}" : item.status_label %>
      </span>
    <% end %>
  </div>
  <%= icon :chevron_right, size: 18, class: "shrink-0 text-base-content/30 sm:hidden" %>
<% end %>
