<% photos = item.photos %>
<% if photos.empty? %>
  <div class="flex aspect-[4/3] flex-col items-center justify-center gap-2 rounded-2xl bg-base-200 text-base-content/30 max-lg:hidden">
    <%= icon(item.tool? ? :wrench : :boxes, size: 40) %>
    <span class="text-sm font-medium">No photos</span>
  </div>
<% else %>
  <div data-controller="gallery" class="min-w-0">
    <div class="relative overflow-hidden rounded-2xl bg-base-200">
      <div class="flex snap-x snap-mandatory overflow-x-auto [scrollbar-width:none]" data-gallery-target="track" data-action="scroll->gallery#trackScrolled">
        <% photos.each_with_index do |photo, index| %>
          <button type="button" class="flex aspect-[4/3] w-full shrink-0 snap-center items-center justify-center p-2 cursor-zoom-in"
                  data-action="gallery#open" data-index="<%= index %>" aria-label="Open photo <%= index + 1 %> in full size">
            <%= image_tag photo, alt: "#{item.name}, photo #{index + 1}", loading: (index.zero? ? "eager" : "lazy"), class: "max-h-full max-w-full rounded-lg object-contain" %>
          </button>
        <% end %>
      </div>
      <% if photos.size > 1 %>
        <span class="badge badge-sm absolute bottom-3 right-3 border-0 bg-neutral/70 text-neutral-content" data-gallery-target="counter">1 / <%= photos.size %></span>
      <% end %>
    </div>
    <% if photos.size > 1 %>
      <div class="mt-2 flex gap-2 overflow-x-auto pb-1">
        <% photos.each_with_index do |photo, index| %>
          <button type="button" class="size-16 shrink-0 overflow-hidden rounded-lg border-2 border-transparent bg-base-200 transition aria-current:border-primary"
                  data-gallery-target="thumb" data-action="gallery#select" data-index="<%= index %>" aria-label="Show photo <%= index + 1 %>" aria-current="<%= index.zero? %>">
            <%= image_tag photo, alt: "", loading: "lazy", class: "size-full object-cover" %>
          </button>
        <% end %>
      </div>
    <% end %>

    <dialog class="lightbox" data-gallery-target="dialog" data-action="close->gallery#closed keydown->gallery#key">
      <div class="flex h-full snap-x snap-mandatory overflow-x-auto [scrollbar-width:none]" data-gallery-target="slides">
        <% photos.each_with_index do |photo, index| %>
          <div class="lightbox-slide" data-action="click->gallery#toggleZoom">
            <img src="<%= photo %>" alt="<%= item.name %>, photo <%= index + 1 %>" loading="lazy" decoding="async">
          </div>
        <% end %>
      </div>
      <div class="pointer-events-none absolute inset-x-0 top-0 flex items-center justify-between gap-2 bg-gradient-to-b from-black/60 to-transparent p-3 pt-[max(0.75rem,env(safe-area-inset-top))]">
        <span class="pointer-events-auto text-sm font-medium text-white/80" data-gallery-target="lightboxCounter"></span>
        <div class="pointer-events-auto flex gap-1">
          <a class="btn btn-circle btn-ghost btn-sm text-white hover:bg-white/15" data-gallery-target="original" target="_blank" rel="noreferrer" aria-label="Open original image">
            <%= icon :external, size: 18 %>
          </a>
          <button type="button" class="btn btn-circle btn-ghost btn-sm text-white hover:bg-white/15" data-action="gallery#close" aria-label="Close">
            <%= icon :close, size: 20 %>
          </button>
        </div>
      </div>
      <% if photos.size > 1 %>
        <button type="button" class="btn btn-circle absolute left-3 top-1/2 -translate-y-1/2 border-0 bg-black/40 text-white hover:bg-black/60 max-sm:hidden" data-action="gallery#previous" aria-label="Previous photo"><%= icon :chevron_left %></button>
        <button type="button" class="btn btn-circle absolute right-3 top-1/2 -translate-y-1/2 border-0 bg-black/40 text-white hover:bg-black/60 max-sm:hidden" data-action="gallery#next" aria-label="Next photo"><%= icon :chevron_right %></button>
      <% end %>
      <p class="pointer-events-none absolute inset-x-0 bottom-0 p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] text-center text-xs text-white/60">Tap the photo to view it at full resolution</p>
    </dialog>
  </div>
<% end %>
