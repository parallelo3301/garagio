{
  "imports": {
    "$fresh/": "https://deno.land/x/fresh@1.7.3/",
    "preact": "https://esm.sh/preact@10.22.0",
    "preact/": "https://esm.sh/preact@10.22.0/",
    "@preact/signals": "https://esm.sh/@preact/signals@1.3.0"
  },
  "tasks": {
    "dev": "deno run -A --watch=static/,routes/,islands/,components/,db/ dev.ts",
    "start": "deno run -A main.ts",
    "check": "deno check main.ts dev.ts",
    "build": "deno compile --allow-read --allow-write --allow-net --allow-ffi --output workshop-inventory main.ts",
    "migrate:create": "deno run --allow-read --allow-write scripts/create_migration.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true
  }
}