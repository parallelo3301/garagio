# Shared password for the web UI and API (required)
ACCESS_PASSWORD=change-me
# HTTP port (Docker/production; `bin/dev` always uses 4000 or DEV_PORT)
PORT=8000
# Trust X-Forwarded-For / X-Real-IP for login bans; enable only behind a reverse proxy
TRUST_PROXY=false
# Redirect to HTTPS and mark cookies secure; enable when served over TLS
FORCE_SSL=false
# Optional: set explicitly, otherwise generated once and stored in the data directory
# SECRET_KEY_BASE=
