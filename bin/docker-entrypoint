#!/bin/bash -e

# Started as root: make the data volume writable for the app user, then drop privileges.
if [ "$(id -u)" = "0" ]; then
  mkdir -p "${GARAGIO_DATA_DIR:-/data}"
  chown -R rails:rails "${GARAGIO_DATA_DIR:-/data}"
  HOME=/home/rails exec setpriv --reuid=rails --regid=rails --init-groups "$0" "$@"
fi

# If running the rails server then create or migrate the database (also adopts databases from the Deno version)
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"
